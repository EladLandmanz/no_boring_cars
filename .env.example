# Copy to .env.local (never commit real keys).
# Project URL is the origin only — no /rest/v1 suffix.
# Dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only. Used later for cron/admin. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Vercel Cron sends Authorization: Bearer <CRON_SECRET>. Required in production.
# Hobby only allows one run per day (vercel.json is 04:00 UTC). Use the Python ping for frequent ticks.
CRON_SECRET=generate_a_long_random_string

# Public URL of this app (email links). No trailing slash.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Resend (server-only). Without RESEND_API_KEY, emails are skipped.
# https://resend.com — verify a domain, or use onboarding@resend.dev to your own inbox only.
RESEND_API_KEY=
EMAIL_FROM=No Boring Cars <onboarding@resend.dev>
# Comma-separated inboxes for "listing submitted for review"
EMAIL_ADMIN_TO=
