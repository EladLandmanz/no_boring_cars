# Copy to .env.local (never commit real keys).
# Project URL is the origin only — no /rest/v1 suffix.
# Dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only. Used later for cron/admin. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Vercel Cron sends Authorization: Bearer <CRON_SECRET>. Required in production.
# Hobby plans only run crons once per day; Pro is needed for every-minute close.
CRON_SECRET=generate_a_long_random_string
